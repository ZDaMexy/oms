<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\osu.TestProject.props" />

  <ItemGroup Label="Package References">
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <PropertyGroup Label="Project">
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup Label="Project References">
    <ProjectReference Include="..\osu.Game.Rulesets.Bms\osu.Game.Rulesets.Bms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\skin-authoring\docs\examples\first-scene\**\*" Exclude="..\skin-authoring\docs\examples\first-scene\README.md">
      <Link>SkinManualExamples\first-scene\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\skin-authoring\docs\examples\reference-study\gameplay-skin.*">
      <Link>SkinManualExamples\reference-study\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\skin-authoring\docs\examples\bga-layout\skin.ini">
      <Link>SkinManualExamples\bga-layout\skin.ini</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="..\osu.Game.Tests\Resources\Videos\test-video.mp4" LogicalName="osu.Game.Rulesets.Bms.Tests.Resources.bga-test-video.mp4" />
    <!-- Retired artwork remains an ordinary import fixture, never an installed canonical skin. -->
    <Content Include="..\skin-authoring\dist\oms-complex.osk">
      <Link>SkinAuthoringSamples\oms-complex.osk</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\skin-authoring\dist\aurora-study.osk">
      <Link>SkinAuthoringSamples\aurora-study.osk</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\doc_md\other\skin-c6-candidate\skin.ini;..\doc_md\other\skin-c6-candidate\gameplay-skin.json;..\doc_md\other\skin-c6-candidate\gameplay-skin.scene.json;..\doc_md\other\skin-c6-candidate\gameplay-skin.script;..\doc_md\other\skin-c6-candidate\tile.png">
      <Link>SkinC6Candidate\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
