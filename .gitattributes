# Autodetect text files and ensure that we normalise their
# line endings to lf internally. When checked out they may
# use different line endings.
* text=auto

# Check out with crlf (Windows) line endings
*.sln text eol=crlf
*.csproj text eol=crlf
*.cs text diff=csharp eol=crlf
*.resx text eol=crlf
*.vsixmanifest text eol=crlf
packages.config text eol=crlf
App.config text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.snippet text eol=crlf
*.manifest text eol=crlf
*.licenseheader text eol=crlf

# Check out with lf (UNIX) line endings
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.md text eol=lf
.travis.yml text eol=lf

# Stable author bytes for the reproducible C6 candidate archive and source digest.
doc_md/other/skin-c6-candidate/*.ini text eol=lf
doc_md/other/skin-c6-candidate/*.json text eol=lf
doc_md/other/skin-c6-candidate/*.script text eol=lf

# Author source files must reproduce the distributed archives after a fresh checkout.
skin-authoring/sources/**/*.ini text eol=lf
skin-authoring/sources/**/*.json text eol=lf
skin-authoring/sources/**/*.script text eol=lf
skin-authoring/dist/*.sha256 text eol=lf
skin-authoring/docs/examples/**/*.json text eol=lf
skin-authoring/docs/examples/**/*.script text eol=lf

# Original unsigned acceptance inputs are preserved byte for byte.
skin-c7-acceptance/legacy/** -text
