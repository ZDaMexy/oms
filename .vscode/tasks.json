{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build osu! (Debug)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "$ErrorActionPreference='Stop'; . ./UseDevelopmentStorage.ps1; dotnet build osu.Desktop -p:GenerateFullPaths=true -m -verbosity:m; exit $LASTEXITCODE"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Build osu! (Release)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "$ErrorActionPreference='Stop'; . ./UseDevelopmentStorage.ps1; dotnet build osu.Desktop -p:Configuration=Release -p:GenerateFullPaths=true -m -verbosity:m; exit $LASTEXITCODE"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
