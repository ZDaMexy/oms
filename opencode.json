{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "dotnet *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git stash*": "allow",
      "git restore*": "allow",
      "git checkout*": "allow",
      "git switch*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "Get-ChildItem*": "allow",
