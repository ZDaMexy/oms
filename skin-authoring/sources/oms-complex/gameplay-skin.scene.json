  "tracks": [
    {
      "id": "astral.rotate-0",
      "type": "tween",
      "target": "astral.orbit-0",
      "property": "rotation",
      "easing": "linear",
      "loop": true,
      "keyframes": [
        {
          "id": "astral.rotate-0.start",
          "time": 0,
          "value": 0
        },
        {
          "id": "astral.rotate-0.end",
          "time": 12000,
          "value": 360
        }
      ]
    },
    {
      "id": "astral.rotate-1",
      "type": "tween",
      "target": "astral.orbit-1",
      "property": "rotation",
      "easing": "linear",
      "loop": true,
      "keyframes": [
        {
          "id": "astral.rotate-1.start",
          "time": 0,
          "value": 0
        },
        {
          "id": "astral.rotate-1.end",
          "time": 12000,
          "value": -360
        }
      ]
    }
  ],
  "stateMachines": [
    {
      "id": "astral.lifecycle",
      "initial": "astral.state.ready",
      "states": [
        {
          "id": "astral.state.ready",
          "set": [
            {
              "id": "astral.state-set.ready",
              "target": "astral.console.status",
              "property": "text",
              "value": "READY"
            }
          ]
        },
        {
          "id": "astral.state.running",
          "set": [
            {
              "id": "astral.state-set.running",
              "target": "astral.console.status",
              "property": "text",
              "value": "RUNNING"
            }
          ]
        },
        {
          "id": "astral.state.paused",
          "set": [
            {
              "id": "astral.state-set.paused",
              "target": "astral.console.status",
              "property": "text",
              "value": "PAUSED"
            }
          ]
        },
        {
          "id": "astral.state.complete",
          "set": [
            {
              "id": "astral.state-set.complete",
              "target": "astral.console.status",
              "property": "text",
              "value": "COMPLETE"
            }
          ]
        },
        {
          "id": "astral.state.failed",
          "set": [
            {
              "id": "astral.state-set.failed",
              "target": "astral.console.status",
              "property": "text",
              "value": "FAILED"
            }
          ]
        }
      ],
      "transitions": [
        {
          "id": "astral.transition.ready.running",
          "from": "astral.state.ready",
          "to": "astral.state.running",
          "event": "gameplay.start"
        },
        {
          "id": "astral.transition.ready.paused",
          "from": "astral.state.ready",
          "to": "astral.state.paused",
          "event": "gameplay.pause"
        },
        {
          "id": "astral.transition.ready.complete",
          "from": "astral.state.ready",
          "to": "astral.state.complete",
          "event": "gameplay.complete"
        },
        {
          "id": "astral.transition.ready.failed",
          "from": "astral.state.ready",
          "to": "astral.state.failed",
          "event": "gameplay.fail"
        },
        {
          "id": "astral.transition.running.paused",
          "from": "astral.state.running",
          "to": "astral.state.paused",
          "event": "gameplay.pause"
        },
        {
          "id": "astral.transition.running.complete",
          "from": "astral.state.running",
          "to": "astral.state.complete",
          "event": "gameplay.complete"
        },
        {
          "id": "astral.transition.running.failed",
          "from": "astral.state.running",
          "to": "astral.state.failed",
          "event": "gameplay.fail"
        },
        {
          "id": "astral.transition.paused.running",
          "from": "astral.state.paused",
          "to": "astral.state.running",
          "event": "gameplay.start"
        },
        {
          "id": "astral.transition.paused.complete",
          "from": "astral.state.paused",
          "to": "astral.state.complete",
          "event": "gameplay.complete"
        },
        {
          "id": "astral.transition.paused.failed",
          "from": "astral.state.paused",
          "to": "astral.state.failed",
          "event": "gameplay.fail"
        },
        {
          "id": "astral.transition.complete.running",
          "from": "astral.state.complete",
          "to": "astral.state.running",
          "event": "gameplay.start"
        },
        {
          "id": "astral.transition.complete.paused",
          "from": "astral.state.complete",
          "to": "astral.state.paused",
          "event": "gameplay.pause"
        },
        {
          "id": "astral.transition.complete.failed",
          "from": "astral.state.complete",
          "to": "astral.state.failed",
          "event": "gameplay.fail"
        },
        {
          "id": "astral.transition.failed.running",
          "from": "astral.state.failed",
          "to": "astral.state.running",
          "event": "gameplay.start"
        },
        {
          "id": "astral.transition.failed.paused",
          "from": "astral.state.failed",
          "to": "astral.state.paused",
          "event": "gameplay.pause"
        },
        {
          "id": "astral.transition.failed.complete",
          "from": "astral.state.failed",
          "to": "astral.state.complete",
          "event": "gameplay.complete"
        }
      ]
    },
    {
      "id": "astral.current-judgement",
      "initial": "astral.judgement.empty",
      "states": [
        {
          "id": "astral.judgement.empty",
          "set": [
            {
              "id": "astral.judgement.hide",
              "target": "astral.console.judgement",
              "property": "opacity",
              "value": 0
            }
          ]
        },
        {
          "id": "astral.judgement.active",
          "set": [
            {
              "id": "astral.judgement.show",
              "target": "astral.console.judgement",
              "property": "opacity",
              "value": 1
            }
          ]
        }
      ],
      "transitions": [
        {
          "id": "astral.judgement.arrive",
          "from": "astral.judgement.empty",
          "to": "astral.judgement.active",
          "event": "judgement.hit"
        }
      ]
    }
  ],
