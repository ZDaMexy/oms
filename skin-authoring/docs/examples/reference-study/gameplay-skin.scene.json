  "tracks": [
    {
      "id": "ref.rotate",
      "type": "tween",
      "target": "ref.icon",
      "property": "rotation",
      "easing": "linear",
      "loop": true,
      "keyframes": [
        {
          "id": "ref.rotate.start",
          "time": 0,
          "value": 0
        },
        {
          "id": "ref.rotate.end",
          "time": 2000,
          "value": 360
        }
      ]
    }
  ],
  "stateMachines": [
    {
      "id": "ref.lifecycle",
      "initial": "ref.ready",
      "states": [
        {
          "id": "ref.ready",
          "set": [
            {
              "id": "ref.ready.text",
              "target": "ref.status",
              "property": "text",
              "value": "READY"
            }
          ]
        },
        {
          "id": "ref.running",
          "set": [
            {
              "id": "ref.running.text",
              "target": "ref.status",
              "property": "text",
              "value": "RUNNING"
            }
          ]
        },
        {
          "id": "ref.paused",
          "set": [
            {
              "id": "ref.pausing.text",
              "target": "ref.status",
              "property": "text",
              "value": "PAUSED"
            }
          ]
        }
      ],
      "transitions": [
        {
          "id": "ref.start",
          "from": "ref.ready",
          "to": "ref.running",
          "event": "gameplay.start"
        },
        {
          "id": "ref.pause",
          "from": "ref.running",
          "to": "ref.paused",
          "event": "gameplay.pause"
        },
        {
          "id": "ref.start-again",
          "from": "ref.paused",
          "to": "ref.running",
          "event": "gameplay.start"
        }
      ]
    }
  ],
  "bindings": [
    {
      "id": "ref.bind.score",
      "target": "ref.score",
      "property": "text",
      "source": "score.value"
