{
  "contract": "oms-gameplay-skin-scene.v1",
  "root": {
    "id": "lesson.root", "type": "container", "target": { "kind": "global" },
    "blend": "inherit", "properties": {}, "effects": [],
    "children": [
      {
        "id": "lesson.hud", "type": "container", "target": { "kind": "global" },
        "slot": "hud.text", "blend": "alpha", "properties": {}, "effects": [],
        "children": [
          {
            "id": "lesson.score", "type": "text", "target": { "kind": "global" },
            "blend": "alpha", "properties": {
              "x": 0.03, "y": 0.02, "font-size": 20, "text": "0", "colour": "#58d3eaff"
            }, "effects": [], "children": []
          },
          {
            "id": "lesson.status", "type": "text", "target": { "kind": "global" },
            "blend": "alpha", "properties": {
              "x": 0.20, "y": 0.02, "font-size": 16, "text": "READY", "colour": "#ffffffff"
            }, "effects": [], "children": []
          },
          {
            "id": "lesson.progress-area", "type": "container", "target": { "kind": "global" },
            "blend": "alpha", "properties": { "x": 0.03, "y": 0.065, "width": 0.30, "height": 0.007 },
            "effects": [], "children": [
              {
                "id": "lesson.progress", "type": "sprite", "target": { "kind": "global" },
                "resource": "lesson.white", "blend": "alpha",
                "properties": { "width": 0, "height": 1, "colour": "#58d3eaff" },
                "effects": [], "children": []
              }
            ]
          },
          {
            "id": "lesson.accent", "type": "sprite", "target": { "kind": "global" },
            "resource": "lesson.white", "blend": "alpha",
            "properties": {
              "x": 0.37, "y": 0.045, "width": 0.018, "height": 0.018,
              "origin": "centre", "colour": "#f3ca78ff"
            }, "effects": [], "children": []
          }
        ]
      }
    ]
  },
  "tracks": [
    {
      "id": "lesson.turn", "type": "tween", "target": "lesson.accent", "property": "rotation",
      "easing": "linear", "loop": true,
      "keyframes": [
        { "id": "lesson.turn.begin", "time": 0, "value": 0 },
        { "id": "lesson.turn.end", "time": 2000, "value": 360 }
      ]
    }
  ],
  "stateMachines": [
    {
      "id": "lesson.lifecycle", "initial": "lesson.ready",
      "states": [
        { "id": "lesson.ready", "set": [
          { "id": "lesson.ready.text", "target": "lesson.status", "property": "text", "value": "READY" }
        ] },
        { "id": "lesson.running", "set": [
          { "id": "lesson.running.text", "target": "lesson.status", "property": "text", "value": "RUNNING" }
        ] },
        { "id": "lesson.paused", "set": [
          { "id": "lesson.paused.text", "target": "lesson.status", "property": "text", "value": "PAUSED" }
        ] }
      ],
      "transitions": [
        { "id": "lesson.start", "from": "lesson.ready", "to": "lesson.running", "event": "gameplay.start" },
        { "id": "lesson.pause", "from": "lesson.running", "to": "lesson.paused", "event": "gameplay.pause" },
        { "id": "lesson.restart", "from": "lesson.paused", "to": "lesson.running", "event": "gameplay.start" }
      ]
    }
  ],
  "bindings": [
    { "id": "lesson.bind.score", "target": "lesson.score", "property": "text", "source": "score.value" },
    { "id": "lesson.bind.progress", "target": "lesson.progress", "property": "width", "source": "timing.progress" }
  ],
  "variants": [],
  "templates": [],
  "instances": []
}
